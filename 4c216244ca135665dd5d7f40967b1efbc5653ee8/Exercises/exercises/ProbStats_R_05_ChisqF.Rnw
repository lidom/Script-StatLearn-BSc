\begin{question}
\textbf{Chi-squared and F-distribution by simulation}

Let $Z_1,\dots,Z_{4}$ be independent standard normal random variables and
$$
W = Z_1^2 + Z_2^2 + \dots + Z_{4}^2 \sim \chi^2_{4}.
$$

\begin{parts}
\item Why can $W$ never take negative values? What are $E(W)$ and $\operatorname{Var}(W)$?
\item Use R to generate $10{,}000$ realizations of $W$ \emph{only} with the help of \texttt{rnorm()}.\\
\emph{Hint:} \texttt{matrix(rnorm(10000 * 4), ncol = 4)} generates a matrix with $10{,}000$ rows and 4 columns; \texttt{rowSums()} sums up each row.
\item Compute the sample mean and the sample variance of your realizations and compare them with the values from (a).
\item Draw a histogram of your realizations (\texttt{freq = FALSE}) and add the density of the $\chi^2_{4}$ distribution using \texttt{curve()} and \texttt{dchisq()}.
\item Estimate $P(W > 9.49)$ from your simulated realizations, and compare with the exact value from \texttt{pchisq()}.
\item Now generate $10{,}000$ realizations of
$$
V = \frac{W_1/4}{W_2/20},\quad W_1\sim\chi^2_{4},\quad W_2\sim\chi^2_{20},\quad W_1\perp W_2,
$$
using \texttt{rchisq()}. Draw a histogram and add the density of the $F_{4,20}$ distribution (\texttt{df()}).
\end{parts}
\end{question}

\begin{solution}
\begin{parts}
\item $W$ is a sum of squares, and squares are never negative. $E(W)=\nu=4$ and $\operatorname{Var}(W)=2\nu=8$.
\item
<<echo=TRUE>>=
nu <- 4
Z <- matrix(rnorm(10000 * nu), ncol = nu)  # 10000 x nu standard normals
W <- rowSums(Z^2)                           # sum of squares in each row
@
\item
<<echo=TRUE>>=
mean(W)   # compare with E(W)   = nu
var(W)    # compare with Var(W) = 2 * nu
@
Both values are close to $\nu=4$ and $2\nu=8$, respectively.
\item
\setkeys{Gin}{width=0.6\textwidth}
<<chisqhist, echo=TRUE, fig=TRUE, height=3.5, width=6, eps=FALSE>>=
hist(W, breaks = 50, freq = FALSE, main = "",
     col = "lightgray", border = "white")
curve(dchisq(x, df = nu), add = TRUE, lwd = 2, col = "red")
@

\item
<<echo=TRUE>>=
mean(W > 9.49)           # estimate from the simulation
1 - pchisq(9.49, df = nu) # exact value
@
Both values are close to $0.05$ ($9.49$ is the 95\% quantile of the $\chi^2_4$ distribution).
\item
\setkeys{Gin}{width=0.6\textwidth}
<<fhist, echo=TRUE, fig=TRUE, height=3.5, width=6, eps=FALSE>>=
nu2 <- 20
W1  <- rchisq(10000, df = nu)
W2  <- rchisq(10000, df = nu2)
V   <- (W1 / nu) / (W2 / nu2)
hist(V, breaks = 80, freq = FALSE, main = "", xlim = c(0, 6),
     col = "lightgray", border = "white")
curve(df(x, df1 = nu, df2 = nu2), add = TRUE, lwd = 2, col = "red")
@

In both cases, the histogram of the simulated realizations matches the theoretical density.
\end{parts}
\end{solution}

