<<echo=FALSE, results=hide>>=
## DATA GENERATION
beta1 <- sample(c(20, 30, 40), 1)        # intercept (EUR)
beta2 <- sample(c(0.6, 0.8, 1.0), 1)     # slope (EUR per m^2)
sigma <- sample(c(10, 20), 1)            # error SD (EUR)
x1    <- 50; x2 <- 100
dist  <- sample(c(10, 20), 1)            # distance above the regression line in (c)

## SOLUTIONS
m1     <- beta1 + beta2 * x1
m2     <- beta1 + beta2 * x2
thresh <- m2 + dist
z_c    <- dist / sigma
P_c    <- 1 - pnorm(z_c)
@

\begin{question}
\textbf{The data-generating process}

The monthly electricity costs $Y_i$ (in EUR) and the living space $X_i$ (in m$^2$) of households $i=1,\dots,n$ are generated by the DGP
$$
Y_i = \beta_1 + \beta_2 X_i + \varepsilon_i,\qquad \varepsilon_i\overset{\text{i.i.d.}}{\sim}\mathcal{N}(0,\sigma^2),
$$
with $\beta_1=\Sexpr{beta1}$, $\beta_2=\Sexpr{beta2}$, $\sigma=\Sexpr{sigma}$, and $X_i\sim\mathcal{N}(80, 20^2)$ independent of $\varepsilon_i$.

\begin{parts}
\item Which variable is the outcome and which is the predictor? What does the error term $\varepsilon_i$ capture? Interpret $\beta_2$.
\item Compute the values of the regression function $m(x)=E(Y_i\mid X_i=x)$ at $x=\Sexpr{x1}$ and $x=\Sexpr{x2}$.
\item Which distribution does $Y_i$ have, given that $X_i=\Sexpr{x2}$? Compute the probability that a household with $\Sexpr{x2}$~m$^2$ has monthly electricity costs above \Sexpr{thresh}~EUR. (Use a table of the standard normal cdf $\Phi$.)
\item In practice, which parts of this DGP are usually unknown?
\item The DGP assumes i.i.d.\ sampling. What does this mean here? Give an example of a data collection where the i.i.d.\ assumption would be violated.
\end{parts}
\end{question}

\begin{solution}
\begin{parts}
\item Outcome: electricity costs $Y_i$. Predictor: living space $X_i$. The error term $\varepsilon_i$ captures everything that affects the electricity costs apart from living space (number of persons, appliances, habits, \dots). $\beta_2=\Sexpr{beta2}$: households that differ by 1~m$^2$ in living space differ, on average, by \Sexpr{beta2}~EUR in their monthly electricity costs.
\item $m(\Sexpr{x1}) = \Sexpr{beta1} + \Sexpr{beta2}\cdot \Sexpr{x1} = \Sexpr{m1}$~EUR and $m(\Sexpr{x2}) = \Sexpr{beta1} + \Sexpr{beta2}\cdot \Sexpr{x2} = \Sexpr{m2}$~EUR.
\item Given $X_i=\Sexpr{x2}$, we have $Y_i = \Sexpr{m2} + \varepsilon_i$, thus
$Y_i\mid X_i=\Sexpr{x2} \sim \mathcal{N}(\Sexpr{m2},\,\Sexpr{sigma}^2)$. Therefore,
$$
P(Y_i > \Sexpr{thresh}\mid X_i=\Sexpr{x2}) = 1 - \Phi\left(\frac{\Sexpr{thresh}-\Sexpr{m2}}{\Sexpr{sigma}}\right) = 1 - \Phi(\Sexpr{fmt(z_c, 2)}) \approx \Sexpr{fmt(P_c, 4)}.
$$
\item Usually unknown are the parameters $\beta_1$, $\beta_2$ and $\sigma^2$, the distribution of the predictor $X_i$, and whether the assumptions of the DGP (linear regression function, normal errors, i.i.d.\ sampling) are correct at all. We only observe one realization $(Y_{1,\operatorname{obs}},X_{1,\operatorname{obs}}),\dots,(Y_{n,\operatorname{obs}},X_{n,\operatorname{obs}})$.
\item i.i.d.: (1) The households are \emph{independent}: the living space and electricity costs of one household tell us nothing about those of another household. (2) All pairs $(Y_i,X_i)$ are \emph{identically distributed}, i.e., drawn from the same joint distribution.\\
Violations: we observe the same household in 12 consecutive months (the observations of the same household are dependent), or we sample several households from the same building with a common heating system; or we sample households from different countries with very different electricity prices (not identically distributed).
\end{parts}
\end{solution}

