<<echo=FALSE, results=hide>>=
mu    <- sample(c(50, 100, 200), 1)
sigma <- sample(c(4, 5, 10), 1)
k     <- sample(c(1, 1.5, 2), 1)
x0    <- mu + k * sigma
Phi   <- pnorm(k)
ans <- c(1 - Phi, Phi, 2 * (1 - Phi), 2 * Phi - 1, 0.5)
questions <- paste0("$", fmt(ans, 4), "$")
explanations <- c(
  paste0("$P(X>", x0, ") = P\\left(Z > \\frac{", x0, "-", mu, "}{", sigma, "}\\right) = 1-\\Phi(", fmt(k, 1), ") = 1-", fmt(Phi, 4), " = ", fmt(1 - Phi, 4), "$."),
  paste0("This is $\\Phi(", fmt(k, 1), ") = P(X\\leq ", x0, ")$."),
  paste0("This is $P(|X-", mu, "|>", k * sigma, ")$, i.e., both tails."),
  paste0("This is $P(|X-", mu, "|\\leq ", k * sigma, ")$."),
  "Only half of the probability mass lies above the \\emph{mean}.")
@

\begin{question}
\textbf{Normal probabilities}

Let $X\sim\mathcal{N}(\Sexpr{mu},\,\Sexpr{sigma}^2)$ and let $\Phi$ denote the cdf of the standard normal distribution, with $\Phi(\Sexpr{fmt(k, 1)}) = \Sexpr{fmt(Phi, 4)}$. What is $P(X > \Sexpr{x0})$?
<<echo=FALSE, results=tex>>=
answerlist(questions)
@
\end{question}

\begin{solution}
<<echo=FALSE, results=tex>>=
answerlist(c("True", rep("False", 4)), explanations)
@
\end{solution}

