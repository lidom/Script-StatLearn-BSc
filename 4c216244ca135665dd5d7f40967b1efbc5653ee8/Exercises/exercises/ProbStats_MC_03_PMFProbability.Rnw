<<echo=FALSE, results=hide>>=
w <- 0:4
probs_list <- list(c(0.10, 0.25, 0.30, 0.20, 0.15),
                   c(0.15, 0.30, 0.25, 0.20, 0.10),
                   c(0.05, 0.20, 0.35, 0.25, 0.15),
                   c(0.20, 0.30, 0.25, 0.15, 0.10))
p <- probs_list[[sample(length(probs_list), 1)]]

ans <- c(sum(p[3:5]),   # P(W >= 2), correct
         sum(p[4:5]),   # P(W > 2)
         sum(p[1:3]),   # P(W <= 2)
         sum(p[2:5]),   # P(W >= 1)
         p[3])          # P(W = 2)
questions <- paste0("$", fmt(ans, 2), "$")
explanations <- c(
  paste0("$P(W\\geq 2) = p_W(2)+p_W(3)+p_W(4) = ", fmt(p[3], 2), "+", fmt(p[4], 2), "+", fmt(p[5], 2), " = ", fmt(ans[1], 2), "$."),
  "This is $P(W>2)$; the value $w=2$ is missing.",
  "This is $P(W\\leq 2)$.",
  "This is $P(W\\geq 1)$.",
  "This is only $P(W=2)$.")
@

\begin{question}
\textbf{Probabilities from a probability mass function}

The number of complaints $W$ per day has the probability mass function
\begin{center}
\begin{tabular}{c|ccccc}
$w_k$ & 0 & 1 & 2 & 3 & 4\\ \hline
$p_W(w_k)$ & \Sexpr{paste(fmt(p, 2), collapse = " & ")}
\end{tabular}
\end{center}
What is $P(W\geq 2)$?
<<echo=FALSE, results=tex>>=
answerlist(questions)
@
\end{question}

\begin{solution}
<<echo=FALSE, results=tex>>=
answerlist(c("True", rep("False", 4)), explanations)
@
\end{solution}

