<<echo=FALSE, results=hide>>=
repeat {
  beta1 <- sample(c(10, 20, 30, 40), 1)
  beta2 <- sample(c(0.5, 1.5, 2, 2.5), 1)
  sigma <- sample(c(4, 5, 8), 1)
  x0    <- sample(c(10, 20, 30), 1)
  ans <- c(beta1 + beta2 * x0, beta2 * x0, beta1 + beta2 * x0 + sigma, beta1 + beta2, beta1 * x0 + beta2)
  if (!any(duplicated(ans))) break
}
questions <- paste0("$", fmt(ans, 1), "$")
explanations <- c(
  paste0("$E(Y_i\\mid X_i=", x0, ") = \\beta_1+\\beta_2\\cdot ", x0, " + E(\\varepsilon_i\\mid X_i=", x0, ") = ", beta1, "+", beta2, "\\cdot ", x0, " + 0 = ", fmt(ans[1], 1), "$."),
  "The intercept $\\beta_1$ is missing.",
  "The error term has mean zero; $\\sigma$ describes the spread around the regression line, not a shift.",
  "The slope $\\beta_2$ must be multiplied by $x$.",
  "The intercept and the slope are mixed up.")
@

\begin{question}
\textbf{Regression function of a DGP}

The data are generated by $Y_i = \beta_1 + \beta_2 X_i + \varepsilon_i$ with $\beta_1=\Sexpr{beta1}$, $\beta_2=\Sexpr{beta2}$, and $\varepsilon_i\sim\mathcal{N}(0,\Sexpr{sigma}^2)$ independent of $X_i$. What is $E(Y_i\mid X_i=\Sexpr{x0})$?
<<echo=FALSE, results=tex>>=
answerlist(questions)
@
\end{question}

\begin{solution}
<<echo=FALSE, results=tex>>=
answerlist(c("True", rep("False", 4)), explanations)
@
\end{solution}

